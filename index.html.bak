<!--  FIXED25 / PORT 3010 / SINGLE PAGE HOST -->
<!DOCTYPE html>

<html lang="nl"><head><meta charset="utf-8"/><meta content="width=device-width,initial-scale=1" name="viewport"/>
<title>KNX</title>
<style>
:root{--bg:#080c10;--p:#111820;--p2:#172129;--line:#27333c;--text:#eef3f7;--muted:#8a98a4;--green:#69dda0;--red:#ff7777}
*{box-sizing:border-box}body{margin:0;background:var(--bg) url("afbeeldingen/smart-home-bg.jpg") center/cover fixed;color:var(--text);font-family:Inter,system-ui,sans-serif}.app{display:grid;grid-template-columns:245px 1fr;min-height:100vh}
aside{position:relative;z-index:20;background:linear-gradient(180deg,rgba(3,8,12,.985),rgba(7,15,21,.985)),url("afbeeldingen/smart-home-bg.jpg") center/cover no-repeat;border-right:1px solid rgba(105,221,160,.18);padding:24px 16px;backdrop-filter:blur(14px);box-shadow:10px 0 40px rgba(0,0,0,.42)}.logo{font-weight:800;font-size:21px;padding:0 12px 30px}.logo span{color:var(--green)}.label{font-size:11px;text-transform:uppercase;color:#9aa9b3;letter-spacing:.08em;padding:12px}
nav button{width:100%;border:0;background:rgba(255,255,255,.025);color:#eef4f7;padding:14px 12px;border-radius:10px;text-align:left;cursor:pointer;margin:2px 0;font-size:16px} nav button::first-letter{font-size:25px}nav button:hover,nav button.active{background:rgba(105,221,160,.18);color:#fff;box-shadow:inset 4px 0 0 var(--green),0 4px 14px rgba(0,0,0,.18)}
main{max-width:1400px;width:100%;margin:auto;padding:30px 36px;position:relative;isolation:isolate}main::before{content:"";position:fixed;inset:0;background:url("afbeeldingen/smart-home-bg.jpg") center/cover no-repeat;opacity:.72;z-index:-2;pointer-events:none}main::after{content:"";position:fixed;inset:0;background:linear-gradient(135deg,rgba(4,9,13,.18),rgba(4,9,13,.46));z-index:-1;pointer-events:none}.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:25px}h1{margin:0;font-size:30px}.muted{color:var(--muted)}.status{display:none}
main > section.page{display:none !important;visibility:hidden !important;position:relative !important;inset:auto !important;z-index:0 !important}main > section.page.active{display:block !important;visibility:visible !important;position:relative !important;inset:auto !important;z-index:1 !important}main > section.page:not(.active),main > section.page[hidden]{display:none !important;visibility:hidden !important}.grid{display:grid;grid-template-columns:repeat(12,1fr);gap:18px}.card{background:rgba(17,24,32,.56);border:1px solid rgba(116,145,157,.25);border-radius:16px;padding:20px;backdrop-filter:blur(10px)}.s4{grid-column:span 4}.s6{grid-column:span 6}.s8{grid-column:span 8}.s12{grid-column:1/-1}
h2{font-size:17px;margin:0 0 17px}.value{font-size:32px;font-weight:800}.row{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:13px 0;border-bottom:1px solid #202b33}.row:last-child{border-bottom:0}
.slider{width:100%;accent-color:var(--green);cursor:pointer}.device{background:var(--p2);border-radius:12px;padding:15px}.devices{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
.lighting-control{background:rgba(24,37,43,.64);border:1px solid rgba(120,150,160,.27);border-radius:20px;padding:22px;margin:14px 0;box-shadow:0 10px 30px rgba(0,0,0,.18);backdrop-filter:blur(8px)}
.lighting-control .topline{display:flex;justify-content:space-between;align-items:center;margin-bottom:7px;font-size:18px}.lighting-control .topline b:last-child{font-size:24px;color:var(--green)} .lighting-control .topline b.dim-value{color:#f0d7a0 !important}
.lighting-control .ga{font-size:11px;color:#7f929c;margin-bottom:18px}.lighting-control .range-wrap{display:flex;align-items:center;gap:14px} .dim-value{color:#f0d7a0}.lighting-control input[type=range],.slider-preview input[type=range]{appearance:none;width:100%;height:18px;border-radius:99px;background:linear-gradient(90deg,#2a343a 0%,#f0d7a0 var(--fill,50%),#2a343a var(--fill,50%),#2a343a 100%);outline:none}.lighting-control input[type=range]::-webkit-slider-thumb,.slider-preview input[type=range]::-webkit-slider-thumb{appearance:none;width:30px;height:30px;border-radius:50%;background:#fff;border:4px solid #d5b77a;box-shadow:0 0 0 2px rgba(255,255,255,.65),0 4px 12px rgba(0,0,0,.28);cursor:pointer}.lighting-control input[type=range]::-moz-range-thumb,.slider-preview input[type=range]::-moz-range-thumb{width:22px;height:22px;border-radius:50%;background:#fff;border:4px solid #d5b77a}
.lighting-control input[type=range]::-webkit-slider-thumb,.slider-preview input[type=range]::-webkit-slider-thumb{appearance:none;width:24px;height:24px;border-radius:50%;background:#f4fbf7;border:4px solid var(--green);box-shadow:none;cursor:pointer}
.lighting-control input[type=range]::-moz-range-thumb,.slider-preview input[type=range]::-moz-range-thumb{width:18px;height:18px;border-radius:50%;background:#f4fbf7;border:4px solid var(--green);box-shadow:none;cursor:pointer}
.feedback{display:none}
.rgbw-control{background:rgba(24,37,43,.64);border:1px solid rgba(120,150,160,.27);border-radius:18px;padding:20px;margin:0;box-shadow:0 12px 30px rgba(0,0,0,.16);backdrop-filter:blur(8px)}.rgbw-top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:15px}.rgbw-top b:last-child{font-size:22px;color:var(--green)}.rgbw-color-slider{appearance:none;width:100%;height:18px;border-radius:999px;background:linear-gradient(90deg,#ffffff 0%,#ff0000 10%,#ffff00 25%,#00ff00 40%,#00ffff 55%,#0000ff 70%,#ff00ff 90%,#ffffff 100%);outline:none;box-shadow:inset 0 0 0 1px rgba(255,255,255,.16),0 5px 18px rgba(0,0,0,.22)}.rgbw-color-slider::-webkit-slider-thumb{appearance:none;width:30px;height:30px;border-radius:50%;background:#fff;border:4px solid #152029;box-shadow:0 0 0 2px rgba(255,255,255,.8),0 4px 12px rgba(0,0,0,.35);cursor:pointer}.rgbw-color-slider::-moz-range-thumb{width:22px;height:22px;border-radius:50%;background:#fff;border:4px solid #152029;box-shadow:0 0 0 2px rgba(255,255,255,.8),0 4px 12px rgba(0,0,0,.35);cursor:pointer}.rgbw-meta{display:flex;align-items:center;gap:10px;margin-top:13px;color:var(--muted);font-size:13px}.rgbw-secondary{display:flex;flex-direction:column;gap:16px;margin-top:18px}.rgbw-secondary label{margin:0 0 8px;font-size:13px}.rgbw-secondary input[type=range]{appearance:none;width:100%;height:18px;border-radius:99px;background:linear-gradient(90deg,#2a343a 0%,#f0d7a0 100%);outline:none}.rgbw-secondary input[type=range]::-webkit-slider-thumb{appearance:none;width:30px;height:30px;border-radius:50%;background:#fff;border:4px solid #d5b77a;box-shadow:0 0 0 2px rgba(255,255,255,.65),0 4px 12px rgba(0,0,0,.28)}.rgbw-secondary input[type=range]::-moz-range-thumb{width:22px;height:22px;border-radius:50%;background:#fff;border:4px solid #d5b77a}.rgbw-presets{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:18px}.preset-dot{width:34px;height:34px;border-radius:50%;border:1px solid rgba(255,255,255,.5);padding:0;cursor:pointer;box-shadow:0 3px 12px rgba(0,0,0,.25);position:relative}.preset-add{background:#17232a;color:#fff;font-size:22px;line-height:1}.preset-dot:hover{transform:scale(1.08);border-color:#fff}.rgbw-swatch{width:34px;height:34px;border-radius:50%;border:2px solid rgba(255,255,255,.78);box-shadow:0 0 18px rgba(255,255,255,.18)}.rgbw-status-dot{width:34px;height:34px;border-radius:50%;border:2px solid rgba(255,255,255,.78);box-shadow:0 0 18px rgba(255,255,255,.16);flex:0 0 auto}.mode-pill{display:none}

.switch{width:46px;height:25px;border-radius:20px;background:#2b3740;padding:3px;cursor:pointer}.switch i{display:block;width:19px;height:19px;border-radius:50%;background:#82909b}.switch.on{background:#2f9364}.switch.on i{margin-left:21px;background:white}
input,select{background:#18232b;color:white;border:1px solid #30404b;border-radius:9px;padding:10px;width:100%}label{display:block;color:var(--muted);font-size:13px;margin:12px 0 6px}.btn{border:1px solid #30404b;background:#1a252d;color:#e4ebef;border-radius:9px;padding:10px 14px;cursor:pointer}.btn:hover{border-color:var(--green)}.primary{background:#256d4b;border-color:#3b9e70}.actions{display:flex;gap:9px;flex-wrap:wrap}.knx{font-family:ui-monospace,monospace}
.log{background:#091015;border:1px solid #1e2a32;border-radius:10px;height:180px;overflow:auto;padding:12px;font:12px ui-monospace,monospace;color:#aebcc5}.ok{color:var(--green)}.err{color:var(--red)}
@media(max-width:850px){.app{grid-template-columns:1fr}aside{border:0}.s4,.s6,.s8{grid-column:1/-1}.devices{grid-template-columns:1fr}main{padding:20px}}

.settings-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.settings-heading{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:15px}
.slider-config{background:var(--p2);border:1px solid var(--line);border-radius:13px;padding:16px;margin:10px 0}
.slider-config-grid{display:grid;grid-template-columns:1.1fr 1fr 1fr 1fr auto;gap:12px;align-items:end}
.slider-preview{display:flex;align-items:center;gap:12px;margin-top:13px;padding-top:12px;border-top:1px solid var(--line)}
.slider-preview input{accent-color:var(--green)}
.room-config-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px}
.badge{display:inline-block;padding:5px 8px;border-radius:7px;background:#13291f;color:var(--green);font-size:11px}
.btn.danger{border-color:#63363a;color:#ff9b9b}
@media(max-width:1000px){.settings-grid{grid-template-columns:repeat(2,1fr)}.slider-config-grid{grid-template-columns:1fr 1fr}}

.lighting-control{background:rgba(23,33,41,.58);border:1px solid rgba(116,145,157,.28);border-radius:13px;padding:17px;backdrop-filter:blur(8px)}
.lighting-control .topline{display:flex;justify-content:space-between;gap:10px;align-items:center}
.lighting-control .ga{font:12px ui-monospace,monospace;color:var(--muted);margin:5px 0 12px}
.feedback{display:none}.lighting-control input[type=range]::-webkit-slider-thumb{width:22px;height:22px;border:3px solid var(--green);background:#f4fbf7;box-shadow:none}.lighting-control input[type=range]::-moz-range-thumb{width:16px;height:16px;border:3px solid var(--green);background:#f4fbf7;box-shadow:none}.lighting-control input[type=range]:hover::-webkit-slider-thumb{transform:scale(1.06)}.lighting-control input[type=range]:focus{outline:none}.lighting-control input[type=range]:focus::-webkit-slider-thumb{box-shadow:0 0 0 4px rgba(105,221,160,.12)}

/* Lighting page: one and only one filter/root; never create a nested page-like panel. */
.lighting-root{width:100%;background:rgba(12,20,27,.48);border:1px solid rgba(116,145,157,.22);border-radius:18px;padding:18px;backdrop-filter:blur(9px)}
.lighting-filter{display:flex;align-items:center;gap:10px;margin-bottom:16px}.lighting-filter select{width:auto;min-width:250px}.lighting-filter .muted{white-space:nowrap}
/* Mobile / iPhone UX */
.menu-toggle{display:none;position:fixed;top:14px;left:14px;z-index:1001;width:48px;height:48px;border:1px solid var(--line);border-radius:14px;background:#111820;color:#fff;font-size:25px;line-height:1;cursor:pointer;box-shadow:0 8px 24px rgba(0,0,0,.28)}
.sidebar-backdrop{display:none}
.room-filter{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:16px}.room-filter select{max-width:240px}
@media(max-width:850px){
 body{overflow-x:hidden}.rgbw-secondary{grid-template-columns:1fr}.app{display:block;min-height:100vh}.menu-toggle{display:flex;align-items:center;justify-content:center}aside{position:fixed;left:0;top:0;bottom:0;width:280px;z-index:1000;transform:translateX(-105%);transition:transform .22s ease;overflow-y:auto;padding:76px 16px 24px;box-shadow:18px 0 40px rgba(0,0,0,.35);background:linear-gradient(180deg,rgba(5,12,18,.97),rgba(8,17,23,.98)),url("afbeeldingen/smart-home-bg.jpg") center/cover no-repeat}aside.open{transform:translateX(0)}.sidebar-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:999}.sidebar-backdrop.show{display:block}main{padding:76px 12px 24px;max-width:none}.top{align-items:flex-start;gap:12px;margin-bottom:16px}.top h1{font-size:27px}.status{display:none}.grid{gap:12px}.card{padding:16px;border-radius:14px}.devices{grid-template-columns:1fr}.lighting-control{padding:18px;border-radius:16px;margin:0}.lighting-control .topline{font-size:19px}.lighting-control .topline b:last-child{font-size:27px}.lighting-control input[type=range]{height:10px}.lighting-control input[type=range]::-webkit-slider-thumb{width:28px;height:28px;border-width:4px}.lighting-control input[type=range]::-moz-range-thumb{width:22px;height:22px;border-width:4px}.feedback{display:none}.settings-grid,.slider-config-grid{grid-template-columns:1fr}.slider-preview{flex-wrap:wrap}.slider-preview input{min-width:160px}.slider-config{padding:14px}.actions .btn{min-height:44px}.room-filter{margin-bottom:12px}.room-filter select{max-width:none;min-height:46px;font-size:16px}.logo{font-size:23px}.label{font-size:12px}nav button{font-size:18px;padding:15px 12px;min-height:52px}nav button::first-letter{font-size:28px}h2{font-size:18px}.row{padding:15px 0}.switch{width:52px;height:29px}.switch i{width:23px;height:23px}.switch.on i{margin-left:23px}
}
.sidebar-status{margin:4px 12px;padding:7px 0;color:#d4dde2;font-size:14px}.sidebar-status.online{color:var(--green)}.sidebar-status.offline{color:#ff9b9b}
/* Final page/desktop visibility guard */
main > section.page[hidden]{display:none !important;visibility:hidden !important}
@media(min-width:851px){
  .app{grid-template-columns:260px 1fr}
  aside{min-height:100vh}
  aside .logo, aside .label, aside nav, aside .sidebar-status{position:relative;z-index:1}
  nav button{font-weight:500}
}

/* FIX23: single visible page host. Other pages live in a hidden cache. */
#pageHost{width:100%;position:relative;min-height:0}
#pageCache{display:none !important;visibility:hidden !important}
#pageHost > section.page{display:block !important;visibility:visible !important;position:relative !important;inset:auto !important;z-index:1 !important}
#pageHost > section.page[hidden]{display:none !important;visibility:hidden !important}

/* FIX25: page templates are inert <template> elements; only #pageHost contains live UI. */
#pageHost{width:100%;position:relative;min-height:0}#pageCache{display:none!important}#pageHost>section.page{display:block!important;visibility:visible!important}#pageHost>section.page[hidden]{display:none!important}
.overview-summary{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.overview-room{background:rgba(23,33,41,.58);border:1px solid rgba(116,145,157,.28);border-radius:14px;padding:15px}.overview-room-head{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:10px}.overview-lights{display:flex;flex-wrap:wrap;gap:8px}.overview-light{padding:7px 10px;border-radius:999px;background:rgba(105,221,160,.12);border:1px solid rgba(105,221,160,.24);color:#dff8ea;font-size:13px}.overview-light.off{background:rgba(255,255,255,.04);border-color:rgba(255,255,255,.08);color:var(--muted)}.lighting-control input[type=range]{height:18px;background:linear-gradient(90deg,#2a343a 0%,#f0d7a0 var(--fill,50%),#f0d7a0 var(--fill,50%),#f0d7a0 100%)}.lighting-control input[type=range]::-webkit-slider-thumb{width:30px;height:30px;border:4px solid #d5b77a;background:#fff;box-shadow:0 0 0 2px rgba(255,255,255,.65),0 4px 12px rgba(0,0,0,.28)}.lighting-control input[type=range]::-moz-range-thumb{width:22px;height:22px;border:4px solid #d5b77a;background:#fff;box-shadow:0 0 0 2px rgba(255,255,255,.65),0 4px 12px rgba(0,0,0,.28)}.rgbw-top b:first-child{font-size:18px}@media(max-width:700px){.overview-summary{grid-template-columns:1fr}}
.camera-card{overflow:hidden}.camera-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:14px}.camera-tile{background:rgba(12,19,24,.72);border:1px solid rgba(255,255,255,.10);border-radius:14px;padding:10px;overflow:hidden}.camera-title{font-weight:700;margin:2px 4px 8px}.camera-frame{background:#05090c;border-radius:10px;aspect-ratio:16/9;display:flex;align-items:center;justify-content:center;overflow:hidden;border:1px solid rgba(255,255,255,.12)}.camera-frame img{display:block;width:100%;height:100%;object-fit:cover;background:#05090c}.camera-url{margin-top:10px}@media(max-width:700px){.camera-grid{grid-template-columns:1fr}.camera-frame{aspect-ratio:16/9}}
</style></head>
<body><button aria-label="Menu" class="menu-toggle" onclick="toggleSidebar()">☰</button><div class="sidebar-backdrop" id="sidebarBackdrop" onclick="closeSidebar()"></div><div class="app">
<aside><div class="label">Dashboard</div><nav>
<button class="active" onclick="page('home',this)">🏠 Overview</button>
</nav><div class="label">Control</div><nav>
<button onclick="page('lighting',this)">💡 Lighting</button><button onclick="page('av',this)">🎬 Audio &amp; Video</button><button onclick="page('cameras',this)">📷 Cameras</button><button onclick="page('climate',this)">🌡️ Climate</button>
</nav><div class="label">Home</div><nav>
<button onclick="page('rooms',this)">🛋️ Rooms</button><button onclick="page('scenes',this)">✨ Scenes</button><button onclick="page('energy',this)">⚡ Energy</button>
</nav><div class="label">System</div><nav><button onclick="page('settings',this)">⚙ Settings</button></nav><div class="label">Status</div><div class="sidebar-status" id="sidebarKnxStatus">● KNX offline</div></aside>
<main><div class="top"><div><h1 id="title">Overview</h1><div class="muted" id="sub"></div></div></div>
<div id="pageHost"></div><div hidden="True" id="pageCache"><template data-page-id="home"><section class="page" id="home"><div class="grid"><div class="card s12"><div class="settings-heading"><div><h2>Lighting overview</h2><div class="muted">Active lighting summarized by room.</div></div><span class="badge" id="overviewLightCount">0 active</span></div><div id="overviewLightingSummary" class="overview-summary"></div></div><div class="card s12"><div class="settings-heading"><div><h2>Audio &amp; Video overview</h2><div class="muted">Prepared for room-based AV devices.</div></div><span class="badge">Ready for AV</span></div><div id="overviewAvSummary" class="overview-summary"></div></div><div class="card s4"><div class="muted">KNX router</div><div class="value" id="homeIp">192.168.200.50</div><div class="muted" id="homeKnx">Not connected</div></div><div class="card s4"><div class="muted">Latest lighting feedback</div><div class="value"><span id="homeLight">70</span>%</div><div class="muted">Live KNX feedback</div></div><div class="card s4"><h2>KNX status</h2><div class="row"><span>KNX/IP</span><b id="knxState">offline</b></div></div></div></section></template><template data-page-id="lighting"><section class="page" id="lighting"><div class="lighting-root" id="lightingRoot"><div class="lighting-filter"><select aria-label="Room" id="lightingRoomFilter" onchange="setLightingRoom(this.value)"></select><span class="muted" id="roomCount"></span></div><div class="devices" id="lightingSliders"></div></div></section></template><template data-page-id="av"><section class="page" id="av"><div class="card"><h2>Audio &amp; Video</h2><div class="row"><span>Samsung TV<br/><small class="muted">Woonkamer</small></span><div class="switch on"><i></i></div></div><div class="row"><span>Sonos Arc<br/><small class="muted">Volume 32%</small></span><div class="switch on"><i></i></div></div></div></section></template><template data-page-id="cameras"><section class="page" id="cameras"><div class="card camera-card"><div class="settings-heading"><div><h2>Cameras</h2><div class="muted">Live camera streams</div></div><span class="badge" id="cameraStatus">Connecting</span></div><div class="camera-grid"><div class="camera-tile"><div class="camera-title">Camera 1</div><div class="camera-frame"><img id="cameraStream0" src="/camera/0.mjpg" alt="Camera 1" onload="cameraOnline(0)" onerror="cameraOffline(0)"></div></div><div class="camera-tile"><div class="camera-title">Camera 2</div><div class="camera-frame"><img id="cameraStream1" src="/camera/1.mjpg" alt="Camera 2" onload="cameraOnline(1)" onerror="cameraOffline(1)"></div></div><div class="camera-tile"><div class="camera-title">Camera 3</div><div class="camera-frame"><img id="cameraStream2" src="/camera/2.mjpg" alt="Camera 3" onload="cameraOnline(2)" onerror="cameraOffline(2)"></div></div><div class="camera-tile"><div class="camera-title">Camera 4</div><div class="camera-frame"><img id="cameraStream3" src="/camera/3.mjpg" alt="Camera 4" onload="cameraOnline(3)" onerror="cameraOffline(3)"></div></div></div></div></section></template><template data-page-id="climate"><section class="page" id="climate"><div class="grid"><div class="card s4"><div class="muted">Temperature</div><div class="value">21,5°</div></div><div class="card s8"><h2>Target temperature</h2><input class="slider" max="25" min="16" oninput="this.nextElementSibling.textContent=this.value+'°'" type="range" value="21"/><div class="value">21°</div></div></div></section></template><template data-page-id="rooms"><section class="page" id="rooms"><div class="card"><h2>Rooms</h2><div class="devices"><div class="device">🛋️ <b>Woonkamer</b><br/><span class="muted">Lighting · TV · Sonos · climate</span></div><div class="device">🍽️ <b>Keuken</b><br/><span class="muted">Lighting · ventilation</span></div><div class="device">🛏️ <b>Slaapkamer</b><br/><span class="muted">Lighting · climate</span></div><div class="device">💼 <b>Kantoor</b><br/><span class="muted">Lighting · climate</span></div></div></div></section></template><template data-page-id="scenes"><section class="page" id="scenes"><div class="card"><h2>Scenes</h2><div class="actions"><button class="btn" onclick="toast('Evening activated')">🌙 Evening</button><button class="btn" onclick="toast('Movie activated')">🎬 Movie</button><button class="btn" onclick="toast('All off activated')">⏻ All off</button></div></div></section></template><template data-page-id="energy"><section class="page" id="energy"><div class="grid"><div class="card s4"><div class="muted">Today</div><div class="value">8,4 kWh</div></div><div class="card s4"><div class="muted">Current</div><div class="value">412 W</div></div><div class="card s4"><div class="muted">Solar</div><div class="value">1,8 kW</div></div></div></section></template><template data-page-id="settings"><section class="page" id="settings"><div class="grid">
<div class="card s12"><h2>KNX/IP connection</h2>
<div class="settings-grid">
<div><label>KNX/IP router / interface IP</label><input id="ip" value="192.168.200.50"/></div>
<div><label>KNX/IP port</label><input id="port" type="number" value="3671"/></div>
<div><label>Communication mode</label><select id="mode"><option selected="" value="TunnelUDP">KNXnet/IP Tunneling (UDP)</option><option value="Multicast">KNXnet/IP Routing (multicast)</option></select></div>
<div><label>Physical address / source IA</label><input id="phys" value="1.1.253"/></div>
</div>
<div class="actions" style="margin-top:16px"><button class="btn primary" onclick="connectKnx()">Connect to KNX</button><button class="btn" onclick="disconnectKnx()">Disconnect</button><button class="btn" onclick="saveConnection()">Save settings</button></div>
</div>
<div class="card s12"><div class="settings-heading"><div><h2>Rooms</h2><div class="muted">Manage the rooms that can be assigned to sliders.</div></div><div class="actions"><input id="newRoomName" placeholder="New room" style="max-width:220px"/><button class="btn primary" onclick="addRoom()">＋ Add room</button></div></div>
<div class="devices" id="roomConfigList"></div></div>
<div class="card s12"><div class="settings-heading"><div><h2>Lighting sliders</h2><div class="muted">Add lighting, choose a room for each slider, and choose between Dim or RGBW.</div></div><button class="btn primary" onclick="addSlider()">＋ Add slider</button></div>
<div id="sliderConfigList"></div></div>
<div class="card s12"><h2>KNX communication log</h2><div class="log" id="log">Dashboard started…</div></div>
</div></section></template></div></main></div><div id="toast" style="position:fixed;right:25px;bottom:25px;background:#1b282f;border:1px solid #3a4c58;padding:13px 17px;border-radius:11px;display:none"></div>
<script>
let socket=null, timer=null;
const meta={home:['Overview',''],lighting:['Lighting',''],av:['Audio & Video','Entertainment'],climate:['Climate','Temperature and ventilation'],rooms:['Rooms','Room control'],scenes:['Scenes','Favorites and automation'],energy:['Energy','Consumption and production'],settings:['Settings','KNX/IP connection and group addresses']};
function resetLightingPage(){
  const page=document.getElementById('lighting');
  if(!page)return;
  page.innerHTML='<div id="lightingRoot" class="lighting-root">'+
    '<div class="lighting-filter">'+
    '<select id="lightingRoomFilter" onchange="setLightingRoom(this.value)" aria-label="Room"></select>'+
    '<span id="roomCount" class="muted"></span>'+
    '</div>'+
    '<div id="lightingSliders" class="devices"></div>'+
    '</div>';
}
let pageTemplates = {};
let currentPageId = null;
function initPageTemplates(){
  const host=document.getElementById('pageHost');
  const cache=document.getElementById('pageCache');
  if(!host||!cache)return;
  pageTemplates={};
  cache.querySelectorAll('template[data-page-id]').forEach(t=>{
    const id=t.dataset.pageId;
    const sec=t.content.firstElementChild;
    if(id&&sec) pageTemplates[id]=sec.outerHTML;
  });
  host.replaceChildren();
}
function showPage(id,b){
  const host=document.getElementById('pageHost');
  const markup=pageTemplates[id];
  if(!host||!markup)return;
  currentPageId=id;
  const tpl=document.createElement('template');
  tpl.innerHTML=markup.trim();
  const target=tpl.content.firstElementChild;
  if(!target)return;
  target.hidden=false;
  target.classList.add('active');
  host.replaceChildren(target);
  document.querySelectorAll('nav button').forEach(x=>x.classList.remove('active'));
  if(b)b.classList.add('active');
  const title=document.getElementById('title');
  const sub=document.getElementById('sub');
  if(title)title.textContent=meta[id][0];
  if(sub)sub.textContent=meta[id][1];
  if(id==='settings'){renderRoomConfigs();renderSliderConfigs();renderCommunicationLog();}
  if(id==='lighting'){resetLightingPage();renderLightingSliders();}
  if(id==='home'){renderOverview();}
}
function renderOverview(){const box=document.getElementById('overviewLightingSummary'),av=document.getElementById('overviewAvSummary');if(!box)return;box.innerHTML='';const ss=sliders(),rs=rooms(),active=[];rs.forEach(room=>{const items=ss.filter(x=>(x.room||'Woonkamer')===room).map(x=>{const value=x.mode==='rgbw'?rgbwBrightnessFromValues(x.feedbackRGBW||[0,0,0,0]):Number(x.feedbackValue??x.value??0);return{name:x.name,value}});if(!items.length)return;const on=items.filter(x=>x.value>0);active.push(...on);const chips=on.length?on.map(x=>'<span class="overview-light">'+esc(x.name)+' <b>'+Math.round(x.value)+'%</b></span>').join(''):'<span class="overview-light off">All lights off</span>';const card=document.createElement('div');card.className='overview-room';card.innerHTML='<div class="overview-room-head"><b>'+esc(room)+'</b><span class="muted">'+on.length+'/'+items.length+' active</span></div><div class="overview-lights">'+chips+'</div>';box.appendChild(card)});if(!box.children.length)box.innerHTML='<div class="overview-room"><span class="muted">No lighting configured yet.</span></div>';const count=document.getElementById('overviewLightCount');if(count)count.textContent=active.length+' active';if(av)av.innerHTML=rs.map(room=>'<div class="overview-room"><div class="overview-room-head"><b>'+esc(room)+'</b><span class="muted">AV</span></div><div class="overview-lights"><span class="overview-light off">No AV devices configured</span></div></div>').join('')||'<div class="overview-room"><span class="muted">No rooms configured yet.</span></div>';}
function page(id,b){closeSidebar();showPage(id,b)}

let knxUiState='offline';
const logBuffer=[];
function log(s,cls=''){
  const entry={time:new Date().toLocaleTimeString(),text:String(s),cls};
  logBuffer.push(entry);
  if(logBuffer.length>80)logBuffer.shift();
  renderCommunicationLog();
}
function renderCommunicationLog(){
  const l=document.getElementById('log');
  if(!l)return;
  l.innerHTML=logBuffer.map(e=>`<div class="${e.cls}">[${e.time}] ${esc(e.text)}</div>`).join('');
  l.scrollTop=l.scrollHeight;
}
function updateKnxUi(connected,message,source='server'){
  knxUiState=connected?'connected':'offline';
  const ks=document.getElementById('knxState'); if(ks)ks.textContent=connected?'online':'offline';
  const hk=document.getElementById('homeKnx'); if(hk)hk.textContent=connected?'Connected':'Not connected';
  const sb=document.getElementById('sidebarKnxStatus');
  if(sb){sb.textContent=connected?'● KNX connected':'● KNX offline';sb.className='sidebar-status '+(connected?'online':'offline');}
  if(message)log(message,connected?'ok':'err');
}

function toast(s){const t=document.getElementById('toast');t.textContent=s;t.style.display='block';clearTimeout(timer);timer=setTimeout(()=>t.style.display='none',2000)}
function cameraOnline(i){window.cameraStates=window.cameraStates||[false,false,false,false];window.cameraStates[i]=true;const e=document.getElementById('cameraStatus');if(e){const n=window.cameraStates.filter(Boolean).length;e.textContent=n+' / 4 Live';e.className=n?'badge online':'badge offline'}}
function cameraOffline(i){window.cameraStates=window.cameraStates||[false,false,false,false];window.cameraStates[i]=false;const e=document.getElementById('cameraStatus');if(e){const n=window.cameraStates.filter(Boolean).length;e.textContent=n+' / 4 Live';e.className=n?'badge online':'badge offline'}}
function connectSocket(){
 if(location.protocol==='file:'){
   document.getElementById('ws').textContent='open through the server URL';
   document.getElementById('ws').className='err';
   log('Open this dashboard through the server URL — do not open index.html directly.','err');
   return;
 }
 if(!location.host){
   document.getElementById('ws').textContent='no host';
   document.getElementById('ws').className='err';
   return;
 }
 socket=new WebSocket((location.protocol==='https:'?'wss://':'ws://')+location.host+'/ws');
 socket.onopen=()=>{log('Dashboard connection established','ok');};
 socket.onclose=()=>{log('Dashboard connection lost — reconnecting…','err');clearTimeout(window.wsRetry);window.wsRetry=setTimeout(connectSocket,3000)};
 socket.onerror=()=>{log('Dashboard connection unavailable. Check that the server is running.','err')};
 socket.onmessage=e=>{const m=JSON.parse(e.data);if(m.type==='knx-status'){updateKnxUi(!!m.connected,m.message|| (m.connected?'KNX connected':'KNX offline'));}
 if(m.type==='feedback'){
   const v=Math.max(0,Math.min(100,Number(m.value)));
   const ga=String(m.ga||'').trim();
   const arr=sliders();
   let sx=arr.find(x=>String(x.feedbackGa||'').trim()===ga);
   let rgbIndex=-1;
   if(!sx){
     sx=arr.find(x=>x.mode==='rgbw' && x.rgbw && Array.isArray(x.rgbw.feedback) && (rgbIndex=x.rgbw.feedback.findIndex(g=>String(g||'').trim()===ga))>=0);
   }
   if(sx){
     if(sx.mode==='rgbw' && rgbIndex>=0){
       sx.feedbackRGBW=sx.feedbackRGBW||[null,null,null,null]; sx.feedbackRGBW[rgbIndex]=v;
       const el=document.getElementById('rgbw-slider-'+sx.id); if(el){el.value=rgbwPositionFromValues(sx.feedbackRGBW)}
       const bright=rgbwBrightnessFromValues(sx.feedbackRGBW), warm=Number(sx.feedbackRGBW[3]??0);
       const bs=document.getElementById('rgbw-bright-slider-'+sx.id), ws=document.getElementById('rgbw-warm-slider-'+sx.id);
       if(bs)bs.value=bright;if(ws)ws.value=warm;
       updateRGBWPreview(sx.id,sx.feedbackRGBW);
       const sw=document.getElementById('rgbw-swatch-'+sx.id); if(sw)sw.style.background=rgbwColorFromValues(sx.feedbackRGBW);
     }else{
       sx.feedbackValue=v;
       const lb=document.getElementById('cfgval-'+sx.id);const lv=document.getElementById('light-val-'+sx.id);const sl=document.getElementById('light-slider-'+sx.id);const prev=document.getElementById('preview-slider-'+sx.id);
       if(lb)lb.textContent=v+'%';if(lv)lv.textContent=v+'%';if(sl){sl.value=v;sl.style.setProperty('--fill',v+'%')}if(prev){prev.value=v;prev.style.setProperty('--fill',v+'%')}
     }
     if(currentPageId==='home')renderOverview();
     saveSliders(arr);
   }
   const homeFb=document.getElementById('homeFb');if(homeFb)homeFb.textContent=v+'%';const homeSlider=document.getElementById('homeSlider');if(homeSlider)homeSlider.value=v;const homeLight=document.getElementById('homeLight');if(homeLight)homeLight.textContent=v;log(`Feedback ${ga} = ${v}%`,'ok');
 }
 }
}
function send(o){if(socket&&socket.readyState===1)socket.send(JSON.stringify(o));else toast('No server connection')}
function sliders(){try{const a=JSON.parse(localStorage.getItem('knxSliders')||'null');return Array.isArray(a)?a:[{id:'w1',name:'Woonkamer',room:'Woonkamer',mode:'dim',writeGa:'1/1/69',feedbackGa:'2/1/69',value:70,feedbackValue:null,rgbw:{write:['','','',''],feedback:['','','','']}}]}catch(e){return []}}
function saveSliders(a){localStorage.setItem('knxSliders',JSON.stringify(a)); syncSharedStateDebounced()}
function normalizeSliders(){const a=sliders().map(x=>({...x,room:x.room||'Woonkamer',mode:x.mode==='rgbw'?'rgbw':'dim',rgbw:x.rgbw||{write:['','','',''],feedback:['','','','']}}));saveSliders(a);return a}
function gaOK(v){return /^\d{1,3}\/\d{1,3}\/\d{1,3}$/.test(v)}
function esc(v){return String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]))}

const DEFAULT_ROOMS=['Woonkamer','Keuken','Eetkamer','Slaapkamer','Kantoor','Badkamer','Hal','Overig'];
function rooms(){try{return JSON.parse(localStorage.getItem('knxRooms')||'null')||DEFAULT_ROOMS.slice()}catch(e){return DEFAULT_ROOMS.slice()}}
function saveRooms(a){localStorage.setItem('knxRooms',JSON.stringify(a)); syncSharedStateDebounced()}
function normalizeRooms(){const a=rooms().map(String).map(x=>x.trim()).filter(Boolean);const unique=[...new Set(a)];if(!unique.length)unique.push(...DEFAULT_ROOMS);saveRooms(unique);return unique}
function roomOptions(selected){const rs=rooms();const active=rs.includes(selected)?selected:(rs[0]||'');return rs.map(r=>'<option '+(r===active?'selected ':'')+'value="'+esc(r)+'">'+esc(r)+'</option>').join('')}
let lightingRoom='all';
function availableRooms(){
 // Toon alle aangemaakte ruimtes, ook als er nog geen slider aan gekoppeld is.
 return rooms();
}
function renderRoomFilter(){
 const sel=document.getElementById('lightingRoomFilter');
 if(!sel)return;
 const rooms=availableRooms();
 if(lightingRoom!=='all'&&!rooms.includes(lightingRoom)) lightingRoom=rooms[0]||'all';
 sel.innerHTML='<option value="all">All rooms</option>'+rooms.map(r=>'<option value="'+esc(r)+'">'+esc(r)+'</option>').join('');
 sel.value=lightingRoom;
 const count=document.getElementById('roomCount');
 const total=sliders().filter(x=>lightingRoom==='all'||(x.room||'Woonkamer')===lightingRoom).length;
 if(count)count.textContent=total+' '+(total===1?'slider':'sliders');
}
function setLightingRoom(v){lightingRoom=v;renderLightingSliders()}
function toggleSidebar(){document.querySelector('aside').classList.toggle('open');document.getElementById('sidebarBackdrop').classList.toggle('show')}
function closeSidebar(){document.querySelector('aside').classList.remove('open');document.getElementById('sidebarBackdrop').classList.remove('show')}
function renderRoomConfigs(){
 const box=document.getElementById('roomConfigList');if(!box)return;
 const rs=normalizeRooms();box.innerHTML='';
 rs.forEach(r=>{
   const count=sliders().filter(x=>(x.room||'Woonkamer')===r).length;
   const d=document.createElement('div');d.className='device';
   d.innerHTML='<div class="row" style="padding:0;border:0"><span><b>'+esc(r)+'</b><br><small class="muted">'+count+' slider'+(count===1?'':'s')+'</small></span><button class="btn danger room-remove">Delete</button></div>';
   const btn=d.querySelector('.room-remove');
   if(count>0){btn.disabled=true;btn.title='Verplaats eerst de sliders uit deze ruimte';}
   btn.addEventListener('click',()=>removeRoom(r));
   box.appendChild(d);
 });
}

function addRoom(){
 const input=document.getElementById('newRoomName');
 const clean=(input?.value||'').trim();
 if(!clean){toast('Vul een naam in');return;}
 const rs=rooms();if(rs.some(r=>r.toLowerCase()===clean.toLowerCase())){toast('Deze ruimte bestaat al');return}
 rs.push(clean);saveRooms(rs);if(input)input.value='';renderRoomConfigs();renderSliderConfigs();renderLightingSliders();toast('Ruimte toegevoegd');
}
function removeRoom(name){
 const rs=rooms();
 if(rs.length<=1){toast('Minimaal één ruimte is nodig');return}
 const used=sliders().some(x=>(x.room||'Woonkamer')===name);
 if(used){toast('Verplaats eerst de sliders uit '+name);return}
 saveRooms(rs.filter(r=>r!==name));
 if(lightingRoom===name)lightingRoom='all';
 renderRoomConfigs();renderSliderConfigs();renderLightingSliders();toast('Room removed');
}
function renderSliderConfigs(){
 const box=document.getElementById('sliderConfigList');if(!box)return;
 const arr=normalizeSliders();box.innerHTML='';
 arr.forEach(x=>{
  x.mode=x.mode==='rgbw'?'rgbw':'dim';
  if(!x.rgbw)x.rgbw={write:['','','',''],feedback:['','','','']};
  const d=document.createElement('div');d.className='slider-config';
  const rgb=x.rgbw;
  const rgbFields=['Red','Green','Blue','White'];
  let addrHtml='';
  if(x.mode==='dim'){
    addrHtml='<div><label>Write groepsadres</label><input class="knx" data-k="writeGa" value="'+esc(x.writeGa||'')+'"></div>'+
             '<div><label>Feedback groepsadres</label><input class="knx" data-k="feedbackGa" value="'+esc(x.feedbackGa||'')+'"></div>';
  }else{
    addrHtml='<div class="s12" style="grid-column:1/-1"><div class="muted" style="margin-bottom:8px">RGBW groepsadressen — Red / Green / Blue / White</div><div class="settings-grid">'+rgbFields.map((n,i)=>'<div><label>'+n+' write</label><input class="knx" data-rgb-write="'+i+'" value="'+esc(rgb.write[i]||'')+'"></div>').join('')+'</div><div class="settings-grid" style="margin-top:8px">'+rgbFields.map((n,i)=>'<div><label>'+n+' feedback</label><input class="knx" data-rgb-feedback="'+i+'" value="'+esc(rgb.feedback[i]||'')+'"></div>').join('')+'</div></div>';
  }
  d.innerHTML='<div class="slider-config-grid" style="grid-template-columns:1.2fr 1fr 1fr auto">'+
   '<div><label>Naam</label><input data-k="name" value="'+esc(x.name)+'"></div>'+
   '<div><label>Ruimte</label><select data-k="room">'+roomOptions(x.room)+'</select></div>'+
   '<div><label>Type</label><select data-k="mode"><option value="dim" '+(x.mode==='dim'?'selected':'')+'>Dim</option><option value="rgbw" '+(x.mode==='rgbw'?'selected':'')+'>RGBW</option></select></div>'+
   '<button class="btn danger" onclick="removeSlider(\''+x.id+'\')">Delete</button></div>'+
   '<div style="margin-top:12px">'+addrHtml+'</div>'+
   '<div class="slider-preview"><b>'+esc(x.name)+'</b><input id="preview-slider-'+x.id+'" style="--fill:'+Number(x.value||0)+'%;flex:1" type="range" min="0" max="100" value="'+Number(x.value||0)+'" oninput="sliderPreview(\''+x.id+'\',this.value)"><b id="cfgval-'+x.id+'">'+Number(x.feedbackValue??x.value??0)+'%</b><span class="mode-pill">'+(x.mode==='rgbw'?'RGBW':'Dim')+'</span></div>';
  d.querySelectorAll('[data-k]').forEach(el=>el.addEventListener('change',()=>{
   const aa=sliders(),q=aa.find(z=>z.id===x.id);if(!q)return;
   if(el.dataset.k==='mode'){q.mode=el.value;q.rgbw=q.rgbw||{write:['','','',''],feedback:['','','','']};saveSliders(aa);renderSliderConfigs();renderLightingSliders();return}
   q[el.dataset.k]=el.value;saveSliders(aa);renderRoomConfigs();renderSliderConfigs();renderLightingSliders();toast('Slider opgeslagen');
  }));
  d.querySelectorAll('[data-rgb-write],[data-rgb-feedback]').forEach(el=>el.addEventListener('change',()=>{
    const aa=sliders(),q=aa.find(z=>z.id===x.id);if(!q)return; q.rgbw=q.rgbw||{write:['','','',''],feedback:['','','','']};
    const i=Number(el.dataset.rgbWrite??el.dataset.rgbFeedback); const key=el.dataset.rgbWrite!==undefined?'write':'feedback';
    if(!gaOK(el.value)){toast('Gebruik bijvoorbeeld 1/1/69');return}
    q.rgbw[key][i]=el.value; saveSliders(aa); renderLightingSliders(); toast('RGBW address saved');
  }));
  box.appendChild(d);
 });
}
function renderLightingSliders(){
 const box=document.getElementById('lightingSliders');if(!box)return;
 renderRoomFilter();
 box.replaceChildren();
 const arr=sliders().filter(x=>lightingRoom==='all'||(x.room||'Woonkamer')===lightingRoom);
 if(!arr.length){box.innerHTML='<div class="muted" style="padding:20px 4px">Geen verlichting in deze ruimte.</div>';return}
 arr.forEach(x=>{
  if(x.mode==='rgbw'){
   x.rgbw=x.rgbw||{write:['','','',''],feedback:['','','','']};
   const vals=x.feedbackRGBW||[null,null,null,null];
   const pos=rgbwPositionFromValues(vals);
   const color=rgbwColorFromValues(vals);
   const brightness=rgbwBrightnessFromValues(vals);
   const warm=Number(vals[3]??0);
   const d=document.createElement('div');d.className='rgbw-control';
   d.innerHTML='<div class="rgbw-top"><b>'+esc(x.name)+'</b><span class="rgbw-status-dot" id="rgbw-status-'+x.id+'" style="background:'+color+'" title="RGBW status"></span></div>'+
     '<input class="rgbw-color-slider" id="rgbw-slider-'+x.id+'" type="range" min="0" max="100" value="'+pos+'" oninput="previewRGBW(\''+x.id+'\')">'+
     '<div class="rgbw-secondary"><div><label>Brightness <b id="rgbw-bval-'+x.id+'">'+brightness+'%</b></label><input id="rgbw-bright-slider-'+x.id+'" type="range" min="0" max="100" value="'+brightness+'" oninput="previewRGBW(\''+x.id+'\')"></div><div><label>Warm white <b id="rgbw-wval-'+x.id+'">'+warm+'%</b></label><input id="rgbw-warm-slider-'+x.id+'" type="range" min="0" max="100" value="'+warm+'" oninput="previewRGBW(\''+x.id+'\')"></div></div>'+
     '<div class="rgbw-presets" id="rgbw-presets-'+x.id+'"></div>';
   box.appendChild(d);
   renderRGBWPresets(x.id);
  }else{
   const fb=(x.feedbackValue===undefined||x.feedbackValue===null)?'—':Number(x.feedbackValue)+'%';
   const d=document.createElement('div');d.className='lighting-control';
   d.innerHTML='<div class="topline"><b>'+esc(x.name)+'</b><b class="dim-value" id="light-val-'+x.id+'">'+fb+'</b></div><div class="range-wrap"><input id="light-slider-'+x.id+'" style="--fill:'+Number(x.value||0)+'%;" type="range" min="0" max="100" value="'+Number(x.value||0)+'" oninput="sendSlider(\''+x.id+'\',this.value)"></div>';
   box.appendChild(d);
  }
 });
}
function addSlider(){
 const a=sliders(),n=a.length+1,g=68+n;
 a.push({id:'s'+Date.now(),name:'Nieuwe slider '+n,room:rooms()[0]||'Overig',mode:'dim',writeGa:'1/1/'+g,feedbackGa:'2/1/'+g,value:0,feedbackValue:null,rgbw:{write:['','','',''],feedback:['','','','']}});
 saveSliders(a);renderSliderConfigs();renderLightingSliders();toast('New slider added');
}
function removeSlider(id){saveSliders(sliders().filter(x=>x.id!==id));renderSliderConfigs();renderLightingSliders();toast('Slider removed')}
function updateSliderValue(id,v){const a=sliders(),x=a.find(z=>z.id===id);if(x){x.value=Number(v);saveSliders(a)}}
function sendSlider(id,v){
 const x=sliders().find(z=>z.id===id);if(!x||x.mode==='rgbw')return;
 updateSliderValue(id,v); const sl=document.getElementById('light-slider-'+id);if(sl)sl.style.setProperty('--fill',Number(v)+'%');
 if(currentPageId==='home')renderOverview();
 send({type:'knx-write',ga:String(x.writeGa).trim(),dpt:'5.001',value:Number(v)});
}
function hueToRgb(h){const s=1,l=.5;const c=(1-Math.abs(2*l-1))*s,x=c*(1-Math.abs((h/60)%2-1)),m=l-c/2;let r=0,g=0,b=0;if(h<60){r=c;g=x}else if(h<120){r=x;g=c}else if(h<180){g=c;b=x}else if(h<240){g=x;b=c}else if(h<300){r=x;b=c}else{r=c;b=x}return [Math.round((r+m)*100),Math.round((g+m)*100),Math.round((b+m)*100)]}
function rgbwFromPosition(pos){pos=Math.max(0,Math.min(100,Number(pos)||0));if(pos<=8||pos>=92)return [0,0,0,100];const hue=((pos-8)/84)*300;return [...hueToRgb(hue),0]}
function rgbwPositionFromValues(vals){const a=(vals||[]).map(v=>Number(v??0));const r=Math.max(0,a[0]||0),g=Math.max(0,a[1]||0),b=Math.max(0,a[2]||0);const mx=Math.max(r,g,b),mn=Math.min(r,g,b);if(mx<=0)return 0;const d=mx-mn;let h=0;if(d===0)h=0;else if(mx===r)h=60*(((g-b)/d)%6);else if(mx===g)h=60*((b-r)/d+2);else h=60*((r-g)/d+4);if(h<0)h+=360;h=Math.min(300,h);return Math.round(8+(h/300)*84)}
function rgbwColorFromValues(vals){const a=(vals||[]).map(v=>Number(v??0));const w=a[3]||0;const r=Math.min(255,Math.round((Math.max(0,a[0]-w)/100)*255+(w/100)*255));const g=Math.min(255,Math.round((Math.max(0,a[1]-w)/100)*255+(w/100)*255));const b=Math.min(255,Math.round((Math.max(0,a[2]-w)/100)*255+(w/100)*255));return 'rgb('+r+','+g+','+b+')'}
function rgbwBrightnessFromValues(vals){const a=(vals||[]).map(v=>Number(v??0));return Math.round(Math.max(a[0]||0,a[1]||0,a[2]||0));}
function rgbwCurrentValues(id){const x=sliders().find(z=>z.id===id);if(!x)return [0,0,0,0];const fb=x.feedbackRGBW||[0,0,0,0];const posEl=document.getElementById('rgbw-slider-'+id);const bEl=document.getElementById('rgbw-bright-slider-'+id);const wEl=document.getElementById('rgbw-warm-slider-'+id);const pos=Number(posEl?.value ?? rgbwPositionFromValues(fb));const b=Number(bEl?.value ?? rgbwBrightnessFromValues(fb));const w=Number(wEl?.value ?? Number(fb[3]??0));const base=rgbwFromPosition(pos);return [Math.round(base[0]*b/100),Math.round(base[1]*b/100),Math.round(base[2]*b/100),Math.round(w)];}
function updateRGBWPreview(id,values){const sw=document.getElementById('rgbw-status-'+id);if(sw)sw.style.background=rgbwColorFromValues(values);const b=rgbwBrightnessFromValues(values),w=Number(values[3]||0);const bv=document.getElementById('rgbw-bval-'+id),wv=document.getElementById('rgbw-wval-'+id);if(bv)bv.textContent=b+'%';if(wv)wv.textContent=w+'%';}
function sendRGBWValues(id,values){const x=sliders().find(z=>z.id===id);if(!x||x.mode!=='rgbw')return;x.rgbw=x.rgbw||{write:['','','',''],feedback:['','','','']};const channels=values.map((v,i)=>({ga:String(x.rgbw.write[i]||'').trim(),value:Math.max(0,Math.min(100,Math.round(Number(v))))})).filter(c=>c.ga&&gaOK(c.ga));if(channels.length)send({type:'knx-write-rgbw',channels});x.value=Number(document.getElementById('rgbw-slider-'+id)?.value||0);}
function previewRGBW(id){const values=rgbwCurrentValues(id);updateRGBWPreview(id,values);if(currentPageId==='home')renderOverview();sendRGBWValues(id,values);}
function sendRGBWColor(id,pos){previewRGBW(id);}
function rgbwPresets(){try{return JSON.parse(localStorage.getItem('knxRGBWPresets')||'{}')||{}}catch(e){return {}}}
function saveRGBWPresets(o){localStorage.setItem('knxRGBWPresets',JSON.stringify(o));syncSharedStateDebounced()}
function renderRGBWPresets(id){const box=document.getElementById('rgbw-presets-'+id);if(!box)return;const list=rgbwPresets()[id]||[];box.innerHTML='<button class="preset-dot preset-add" title="Save current color" onclick="saveRGBWPreset(\''+id+'\')">+</button>'+list.map((p,i)=>'<button class="preset-dot" title="Preset '+(i+1)+' — hold to delete" style="background:'+esc(p.color||'rgb(255,255,255)')+'" onpointerdown="presetPressStart(event,\''+id+'\','+i+')" onpointerup="presetPressEnd(event)" onpointerleave="presetPressEnd(event)" onpointercancel="presetPressEnd(event)" onclick="applyRGBWPreset(\''+id+'\','+i+')"></button>').join('')}
function saveRGBWPreset(id){const all=rgbwPresets();const list=all[id]||[];const pos=Number(document.getElementById('rgbw-slider-'+id)?.value||0),brightness=Number(document.getElementById('rgbw-bright-slider-'+id)?.value||0),warm=Number(document.getElementById('rgbw-warm-slider-'+id)?.value||0);const color=rgbwColorFromValues(rgbwCurrentValues(id));list.push({pos,brightness,warm,color});all[id]=list.slice(-12);saveRGBWPresets(all);renderRGBWPresets(id);toast('Color preset saved')}
let presetPressTimer=null,presetLongPress=false;
function presetPressStart(ev,id,index){presetLongPress=false;clearTimeout(presetPressTimer);presetPressTimer=setTimeout(()=>{presetLongPress=true;deleteRGBWPreset(id,index)},650)}
function presetPressEnd(ev){clearTimeout(presetPressTimer);presetPressTimer=null}
function deleteRGBWPreset(id,index){const all=rgbwPresets();const list=all[id]||[];if(index<0||index>=list.length)return;list.splice(index,1);all[id]=list;saveRGBWPresets(all);renderRGBWPresets(id);toast('Preset deleted')}
function applyRGBWPreset(id,index){if(presetLongPress){presetLongPress=false;return}const p=(rgbwPresets()[id]||[])[Number(index)];if(!p)return;const cs=document.getElementById('rgbw-slider-'+id),bs=document.getElementById('rgbw-bright-slider-'+id),ws=document.getElementById('rgbw-warm-slider-'+id);if(cs)cs.value=p.pos;if(bs)bs.value=p.brightness;if(ws)ws.value=p.warm;previewRGBW(id);toast('Preset applied')}
function sliderPreview(id,v){updateSliderValue(id,v);const lab=document.getElementById('cfgval-'+id);if(lab)lab.textContent=v+'%';const prev=document.getElementById('preview-slider-'+id);if(prev)prev.style.setProperty('--fill',v+'%');const x=sliders().find(z=>z.id===id);if(x&&x.mode==='dim')send({type:'knx-write',ga:String(x.writeGa).trim(),dpt:'5.001',value:Number(v)})}
function setLight(v){
 const x=sliders()[0];if(x)sendSlider(x.id,v);
}
function saveConnection(){localStorage.setItem('knxConnection',JSON.stringify({ip:ip.value,port:port.value,mode:mode.value,phys:phys.value}));toast('KNX settings saved')}
function loadConnection(){try{const x=JSON.parse(localStorage.getItem('knxConnection')||'{}');if(x.ip)ip.value=x.ip;if(x.port)port.value=x.port;if(x.mode)mode.value=x.mode;if(x.phys)phys.value=x.phys}catch(e){}}
function pageById(id){showPage(id);const b=[...document.querySelectorAll('nav button')].find(x=>(x.getAttribute('onclick')||'').includes("page('"+id+"'"));if(b)b.classList.add('active')}
function applySharedState(state){
 if(!state)return;
 if(Array.isArray(state.rooms)) localStorage.setItem('knxRooms',JSON.stringify(state.rooms));
 if(Array.isArray(state.sliders)) localStorage.setItem('knxSliders',JSON.stringify(state.sliders));
 if(state.presets && typeof state.presets==='object') localStorage.setItem('knxRGBWPresets',JSON.stringify(state.presets));
 renderRoomConfigs();renderSliderConfigs();renderLightingSliders();
}
let lastSharedSignature='';
function sharedSignature(state){
 try{return JSON.stringify({rooms:state?.rooms||[],sliders:state?.sliders||[],presets:state?.presets||{}});}catch(e){return ''}
}
async function syncSharedState(){
 try{
  const r=await fetch('/api/state',{cache:'no-store'});
  if(!r.ok)throw new Error('state '+r.status);
  const state=await r.json();
  const sig=sharedSignature(state);
  const active=document.activeElement;
  const editing=!!(active && (active.matches('input,select,textarea') || active.isContentEditable));
  // Do not rebuild the DOM while an input/select is focused. The previous
  // 2-second refresh replaced the field under the user's finger.
  if(sig===lastSharedSignature) return;
  lastSharedSignature=sig;
  if(editing) return;
  const serverHasData=(Array.isArray(state.rooms)&&state.rooms.length)||(Array.isArray(state.sliders)&&state.sliders.length);
  if(serverHasData){
    applySharedState(state);
  }else{
    normalizeRooms();normalizeSliders();
    await postSharedState();
  }
  renderRoomConfigs();renderSliderConfigs();renderLightingSliders();if(currentPageId==='home')renderOverview();loadConnection();
 }catch(e){
  // Keep the current UI intact on a temporary network error.
 }
}
let syncTimer=null;
function syncSharedStateDebounced(){clearTimeout(syncTimer);syncTimer=setTimeout(postSharedState,700);}
async function postSharedState(){
 try{
  const payload={rooms:rooms(),sliders:sliders(),presets:rgbwPresets()};
  const r=await fetch('/api/state',{method:'POST',headers:{'Content-Type':'application/json','Cache-Control':'no-cache'},cache:'no-store',body:JSON.stringify(payload)});
  if(!r.ok)throw new Error('save '+r.status);
  lastSharedSignature=sharedSignature(payload);
 }catch(e){}
}
syncSharedState();

function connectKnx(){const ss=sliders();const feedbackGAs=[];ss.forEach(x=>{if(x.mode==='rgbw'){(x.rgbw?.feedback||[]).forEach(g=>{if(g)feedbackGAs.push(String(g).trim())})}else if(x.feedbackGa)feedbackGAs.push(String(x.feedbackGa).trim())});send({type:'knx-connect',config:{ip:ip.value,port:Number(port.value),mode:mode.value,physAddr:phys.value,writeGa:ss[0]?.writeGa||'1/1/69',feedbackGa:feedbackGAs[0]||'2/1/69',feedbackGAs:[...new Set(feedbackGAs)]}})}
function disconnectKnx(){send({type:'knx-disconnect'})}
connectSocket();
window.addEventListener('DOMContentLoaded',()=>{
  initPageTemplates();
  showPage('home');renderOverview();
});
</script></body></html>